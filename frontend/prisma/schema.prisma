datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  VIEWER
  MANAGER
  ADMIN
}

enum ImportBatchStatus {
  PENDING
  VALIDATED
  COMMITTED
  FAILED
}

enum InventoryChangeType {
  IMPORT
  MANUAL
  ORDER
}

enum BackupStatus {
  SUCCESS
  FAILED
}

enum CloudProvider {
  GOOGLE_DRIVE
  ONEDRIVE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String?
  role         Role      @default(CUSTOMER)
  notifyEmail  Boolean   @default(true)
  notifySms    Boolean   @default(false)
  notifyApp    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  addresses    Address[]
  orders       Order[]
  cloudAccounts CloudAccount[]
  auditLogs    AuditLog[]
  importBatches ProductImportBatch[]
  inventoryLogs InventoryLog[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  line1     String
  line2     String?
  city      String
  state     String?
  pincode   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  description String
  categoryId  String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
  images      ProductImage[]
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([title])
  @@index([updatedAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  sku       String   @unique
  size      String
  color     String
  pricePaise Int
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLogs InventoryLog[]

  @@index([pricePaise])
  @@index([stock])
}

model ProductImportBatch {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  createdByUserId String
  filename      String
  status        ImportBatchStatus @default(PENDING)
  totalRows     Int               @default(0)
  validRows     Int               @default(0)
  errorRows     Int               @default(0)
  durationMs    Int?
  committedAt   DateTime?
  errors        ProductImportRowError[]
  auditLogs     AuditLog[]
  inventoryLogs InventoryLog[]
  createdByUser User              @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([status])
}

model ProductImportRowError {
  id          String   @id @default(cuid())
  batchId     String
  rowNumber   Int
  productCode String?
  field       String?
  message     String
  suggestion  String?
  raw         Json?
  createdAt   DateTime @default(now())
  batch       ProductImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, rowNumber])
}

model InventoryLog {
  id               String              @id @default(cuid())
  createdAt        DateTime            @default(now())
  changeType       InventoryChangeType
  sku              String
  variantId        String?
  quantityBefore   Int?
  quantityAfter    Int?
  priceBeforePaise Int?
  priceAfterPaise  Int?
  userId           String?
  batchId          String?
  note             String?

  variant          ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  batch            ProductImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([sku])
  @@index([batchId])
}

model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  details     Json?
  ip          String?
  userAgent   String?
  batchId     String?

  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  batch       ProductImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

model BackupHistory {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  status        BackupStatus
  rowCount      Int         @default(0)
  checksum      String?
  location      String?
  errorMessage  String?
  retainedUntil DateTime

  @@index([createdAt])
  @@index([retainedUntil])
}

model CloudAccount {
  id           String        @id @default(cuid())
  userId       String
  provider     CloudProvider
  scope        String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider])
}

model Order {
  id            String          @id @default(cuid())
  userId        String?
  customerName  String
  customerPhone String
  customerEmail String?
  addressLine1  String
  addressLine2  String?
  city          String
  state         String?
  pincode       String
  paymentMethod String          // COD | UPI | CARD | RAZORPAY
  status        String          @default("PLACED") // PLACED | PROCESSING | SHIPPED | OUT_FOR_DELIVERY | DELIVERED | CANCELLED
  notifyEmail   Boolean         @default(true)
  notifySms     Boolean         @default(false)
  notifyApp     Boolean         @default(true)
  trackingNumber String?
  trackingUrl   String?
  etaDate       DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  tracking      TrackingEvent[]
  messages      Message[]
  items         OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  variantId   String
  title       String
  slug        String
  imageUrl    String?
  size        String
  color       String
  pricePaise  Int
  quantity    Int
  createdAt   DateTime @default(now())
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model TrackingEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    String
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Message {
  id        String         @id @default(cuid())
  orderId   String
  channel   String
  content   String
  createdAt DateTime       @default(now())
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
